{
  "expo": {
    "name": "Tavi",
    "slug": "resolve-mei",
    "version": "1.0.1",
    "backgroundColor": "#F7F5F2",
    "orientation": "portrait",
    "scheme": "resolvemei",
    "icon": "./assets/images/icon-master.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 2,
      "backgroundColor": "#F7F5F2",
      "adaptiveIcon": {
        "backgroundColor": "#121A1F",
        "foregroundImage": "./assets/images/tavi-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.resolvemei"
    },
    "web": {
      "favicon": "./assets/images/icon-master.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o Tavi acesse suas fotos para selecionar imagens do perfil, do negócio e evidências do serviço.",
          "cameraPermission": "Permita que o Tavi use a câmera para registrar evidências do serviço.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F5F2",
          "android": {
            "drawable": {
              "icon": "./assets/images/splash-transparent.xml"
            }
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
