{
  "expo": {
    "name": "ResolveMEI",
    "slug": "resolve-mei",
    "version": "1.0.0",
    "backgroundColor": "#121A1F",
    "orientation": "portrait",
    "scheme": "resolvemei",
    "icon": "./assets/images/icon-master.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "backgroundColor": "#121A1F",
      "adaptiveIcon": {
        "backgroundColor": "#121A1F",
        "foregroundImage": "./assets/images/tavi-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.resolvemei"
    },
    "web": {
      "favicon": "./assets/images/icon-master.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false,
          "hidden": false,
          "style": "dark"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o ResolveMEI acesse suas fotos para selecionar imagens do perfil, do negócio e evidências do serviço.",
          "cameraPermission": "Permita que o ResolveMEI use a câmera para registrar evidências do serviço.",
          "microphonePermission": false
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#121A1F",
          "image": "./assets/images/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
