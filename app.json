{
  "expo": {
    "name": "ResolveMEI",
    "slug": "resolve-mei",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "resolvemei",
    "icon": "./assets/resolve-mei-logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E4D4E",
        "foregroundImage": "./assets/resolve-mei-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/resolve-mei-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita que o ResolveMEI acesse suas fotos para selecionar o logotipo do negócio."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E4D4E",
          "image": "./assets/resolve-mei-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
