# Public values are embedded in the mobile bundle. Never put secrets here.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_SUPABASE_URL=https://example-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example_only
# HTTPS page that receives the token only in its URL fragment.
EXPO_PUBLIC_CLIENT_QUOTE_BASE_URL=https://resolve-mei.pages.dev/q
